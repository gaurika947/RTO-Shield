# RTO-Shield Environment Configuration
# Copy this file to .env and configure local values as needed.
# NEVER commit .env with real secrets to version control.

# Server Port (default: 3001)
PORT=3001

# Python Executable (default: python)
PYTHON_EXECUTABLE=python

# HMAC Signing Secret for Server Decision Tokens (use a strong random string in production)
DECISION_HMAC_SECRET=rto_shield_internal_signing_secret_v1

# CORS Allowed Origins (comma-separated, default includes localhost:5173, localhost:3000)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Google Gemini API Key — Server-side ONLY (never exposed to frontend)
# If left empty, system gracefully defaults to deterministic risk analysis
GEMINI_API_KEY=

# Razorpay Integration (Prototype Stub — NOT connected to live banking rails)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
